# ---------------------------------------------------------------------------
# Trinomul Blood Bank Rangpur — Environment Variables
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Database (Choose one: Supabase/PostgreSQL or SQLite) ------------------
# For Supabase/PostgreSQL (Production):
# Direct connection string used by the server. The app uses custom JWT auth
# (not Supabase Auth), so the server talks to Supabase Postgres over raw SQL
# with the `pg` driver — no Supabase anon/service-role keys needed for data.
#
# Use the "Session pooler" string:
#   Supabase Dashboard -> Settings -> Database -> Connection string -> Session pooler
# Format:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Optional: force database selection. auto (default) detects from DATABASE_URL.
# DATABASE_TYPE=auto

# For SQLite (Development/Local):
# (Uses ./data/bloodbank.db by default - no additional config needed)

# --- Auth (REQUIRED in production) ----------------------------------------
# Secret used to sign/verify JWT session cookies (lib/auth/token.ts).
# Generate one with:  openssl rand -base64 32
# In development this falls back to a built-in dev secret; in production the
# app will refuse to start without it.
AUTH_SECRET=

# --- Site URL -------------------------------------------------------------
# Canonical domain used for SEO, canonical URLs, hreflang, OpenGraph images,
# the sitemap and robots.txt.
# Production: https://trinomul.vercel.app
# After pointing trinomul.org at the Vercel deployment, switch to:
#   NEXT_PUBLIC_SITE_URL=https://trinomul.org
NEXT_PUBLIC_SITE_URL=https://trinomul.vercel.app

# --- reCAPTCHA (optional) -------------------------------------------------
# Google reCAPTCHA v2 site key for the blood request form. Get one at
# https://www.google.com/recaptcha/admin. Leave blank to disable the
# CAPTCHA widget in development.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# --- AI Providers (optional, Phase 4) ------------------------------------
# Used for AI-powered donor insights, demand forecasting, anomaly detection,
# and natural language admin queries.
#
# Provider chain: DeepSeek (primary) → Zhipu (fallback) → rule-based.
# Set at least one key to enable AI. If both are missing, the app uses
# deterministic rule-based insights so it still works in development.
#
# DeepSeek (recommended — cheap, strong reasoning):
#   Get a key at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Zhipu AI / GLM (fallback — free tier available, strong multilingual):
#   Get a key at: https://open.bigmodel.cn/usercenter/apikeys
ZHIPU_API_KEY=

# --- Cloudinary (optional — profile and community photo uploads) --------------
# Profile and community uploads go directly from the browser to Cloudinary
# using an UNSIGNED upload preset. Only these public values are needed (the
# API secret stays server-side and is never exposed).
#
# 1. Create an unsigned preset: Cloudinary Dashboard → Settings → Upload →
#    Upload presets → Add upload preset → Signing Mode = Unsigned.
# 2. Fill in the values below.
# Without these, text posts still work; the photo button is disabled.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Server-only Cloudinary credentials. Never expose these with NEXT_PUBLIC_ and never commit them.
# These are REQUIRED for NID (national ID) verification uploads — NID images
# are uploaded as `type: "authenticated"` and only viewable by admins via
# short-lived signed URLs generated in lib/cloudinary-server.ts.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Redis (Production) ---------------------------------------------------
# Redis is used for distributed rate limiting and caching.
# Required for multi-instance deployments.
REDIS_URL=redis://localhost:6379
# Or use individual settings:
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_TLS=false

# --- Migrations -----------------------------------------------------------
# Set to false to disable automatic migrations on startup
RUN_MIGRATIONS_ON_STARTUP=true

# --- Database Type --------------------------------------------------------
# Choose: auto (detects Supabase), sqlite, postgresql
DATABASE_TYPE=auto

# --- Email (Resend) — optional ------------------------------------------------
# Transactional email system: blood request alerts to nearby donors,
# password resets, welcome emails, application decisions.
# Get an API key at https://resend.com/api-keys.
# Without RESEND_API_KEY, all emails are silently skipped (dev still works).
# EMAIL_FROM must use a sender domain you have verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Trinomul Blood Bank <noreply@trinomul.org>
# Absolute URL of the logo embedded in every email (email clients cannot
# load relative paths). Defaults to {NEXT_PUBLIC_SITE_URL}/trinomul-logo.png.
EMAIL_LOGO_URL=
# Safety cap on non-critical emails per day (free tier is 100/day; password
# resets bypass this cap). Defaults to 90.
DAILY_EMAIL_CAP=90

# --- Web Push (PWA notifications) — optional --------------------------------
# VAPID keypair for Web Push notifications (new posts / blood requests).
# Generate with:  npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY and NEXT_PUBLIC_VAPID_PUBLIC_KEY use the SAME public key.
# Without these, the notification bell is hidden; the app still works.
VAPID_SUBJECT=mailto:contact@trinomul.org
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
